/assets/backgrounds/real_photos/
/assets/backgrounds/ai_generated/
/reference images/

# Keep the local Hugging Face dataset staging payload out of the project repository
/hf_upload/indic-synthetic-scene-text-1000/images/
/hf_upload/indic-synthetic-scene-text-1000/annotations/
/hf_upload/indic-synthetic-scene-text-1000/metadata/
/hf_upload/indic-synthetic-scene-text-1000/validation_reports/

